# Copy to .env on the server; set mode 600. Never commit real credentials.
GITHUB_TOKEN=
# Global public-repository monitoring, with only redacted identities retained.
SEARCH_PATTERN=sk-
GITHUB_PER_PAGE=100
GITHUB_MAX_PAGES=5
GITHUB_SORT=indexed
GITHUB_MIN_INTERVAL=6.5
SEARCH_GLOBAL_PAGES=1
FETCH_FILE_CONTENT=true

AI_ENABLED=true
AI_BASE_URL=https://4router.net/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_TIMEOUT=60
AI_MAX_FILES=200
AI_MAX_TOKENS=2000
KEY_CONTEXT_CHARS=1200
AI_TEMPERATURE=0.05

# Do not automatically probe discovered credentials.
AUTO_TEST_LLM=false
DB_PATH=data/monitor.db
WEB_HOST=0.0.0.0
WEB_PORT=8765
# Internal loopback port; select a free value after inspecting the server.
NGINX_PORT=18080
SCAN_INTERVAL=7200
SCAN_INCREMENTAL=true
SCAN_TRIGGER_FILE=data/scan.trigger
STALE_TASK_SECONDS=14400
HEALTH_MAX_SCAN_AGE=18000
