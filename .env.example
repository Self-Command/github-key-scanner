# ============ GitHub 代码搜索（必需，真实扫描才需要）============
# 获取方式：GitHub → Settings → Developer settings → Fine-grained tokens
# 权限：仅勾选 Public repositories 的 Contents: Read-only 即可
GITHUB_TOKEN=

# ============ AI 分析（OpenAI 兼容接口，推荐配置）============
# 可填 DeepSeek / GLM / Kimi / 通义 / 硅基流动 等任意 OpenAI 兼容服务
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ============ 可选调优 ============
# 每页结果数（上限 100）、每个语言查询的最大抓取页数、排序方式（indexed=最近索引）
GITHUB_PER_PAGE=100
GITHUB_MAX_PAGES=5
GITHUB_SORT=indexed
# 搜索字面量：GitHub 端按该词做子串搜索（不用正则，正则受限），本地再严格过滤。
# 默认 sk- 可覆盖 sk-*/sk-proj-/sk-ant- 等变体；想补充 gsk_/tvly- 等前缀可改为多词：
# 注意：GitHub 对 OR 组合支持不稳定，建议保持单词，其余前缀在分析阶段本地提取。
SEARCH_PATTERN=sk-
# 全局兜底查询页数：覆盖 .env/.conf/.cfg 等无 language 类型的文件（0 = 关闭）
SEARCH_GLOBAL_PAGES=1
# 是否拉取文件全文用于分析（更准；raw 域名直取，不限 API 配额）
FETCH_FILE_CONTENT=true
# 每轮最多调用 AI 的文件数；超出部分自动改用规则引擎
AI_MAX_FILES=200
# 单文件提交 AI 的 token 上限（超限则截取密钥前后上下文，默认 2000）
AI_MAX_TOKENS=2000
# 截取时每个密钥前后保留的字符数（默认 1200）
KEY_CONTEXT_CHARS=1200
# AI 分析温度：越低越稳定保守（默认 0.05；数值越大越发散，不建议超过 0.2）
AI_TEMPERATURE=0.05
# 新增大模型密钥入库后自动调用 /v1/models 测试有效性（只读、零消耗）
AUTO_TEST_LLM=true
# 数据库位置（相对项目根目录）
DB_PATH=data/keys.db
# Web 服务监听地址：本机默认 127.0.0.1；Docker 容器部署必须设为 0.0.0.0（compose 已自动注入）
# WEB_HOST=127.0.0.1
# Web 服务端口
WEB_PORT=8765

# ============ 全自动托管（daemon）============
# daemon 两轮扫描间隔（秒），默认 7200 = 2 小时
SCAN_INTERVAL=7200
# 增量扫描：只扫描上次成功扫描后新索引的文件（时间窗口 + 文件指纹去重）
SCAN_INCREMENTAL=true
